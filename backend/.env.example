# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="OSINT Threat Intelligence Platform"
API_V1_STR=/api/v1
LOG_LEVEL=INFO
PORT=8000

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=threat_atlas

# Fallback / Local compatibility aliases
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=threat_atlas

# Redis Connection (Render Managed Redis or Upstash)
# Format: rediss://default:<password>@<host>:<port> or redis://<host>:<port>/0
REDIS_URL=rediss://default:<password>@your-redis-instance.upstash.io:6379

# Trusted Frontend CORS Origins (comma-separated or JSON array)
ALLOWED_ORIGINS=https://threatatlas.vercel.app,http://localhost:3000
